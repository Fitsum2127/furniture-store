# Copy this file to server/.env and replace the values. Never commit server/.env.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=
UPLOADS_DIR=
SERVE_CLIENT=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=furniture_store
DB_SSL=false

# Two different random texts of 48+ characters each (see README, step 4)
JWT_SECRET=replace-with-a-long-random-text-1
CUSTOMER_JWT_SECRET=replace-with-a-different-long-random-text-2

# Only when the real gateway integration exists (not included yet):
# CHAPA_SECRET_KEY=
# TELEBIRR_APP_KEY=